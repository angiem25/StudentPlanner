@startuml
!theme plain
skinparam classAttributeIconSize 0

title Student Planner - Class Diagram

package "mvc" {

  interface ModelListener {
  }

  abstract class AbstractModel implements Model {
    + addModelListener(): void
    + removeModelListener(): void
    + notifyChanged(): void
    # fireModelChanged(): void
    # fireModelChanged(): void
  }

  abstract class AbstractController implements Controller {
    - model: Model
    - view: View
    ..
    + getModel(): Model
    + getView(): View
    + setModel(): void
    + setView(): void
  }

  class ModelEvent {
    - eventName: String
    - source: Object
    - data: Object
    ..
    + getEventName(): String
    + getSource(): Object
    + getData(): Object
    + toString(): String
  }

  abstract class AbstractView implements View, ModelListener {
    - model: Model
    - controller: Controller
    ..
    + getModel(): Model
    + getController(): Controller
    + setModel(): void
    + setController(): void
  }

  interface Controller {
  }

  interface View {
  }

  interface Model {
  }

}

package "planner" {

  class Main {
    + main(): void
  }

}

package "planner.ui" {

  class PlannerView extends AbstractView {
    - frame: JFrame
    - tabbedPane: JTabbedPane
    - studentPanel: JPanel
    - firstNameField: JTextField
    - lastNameField: JTextField
    - emailField: JTextField
    - studentIdField: JTextField
    - yearField: JTextField
    - majorField: JTextField
    - saveStudentButton: JButton
    - studentInfoLabel: JLabel
    - coursePanel: JPanel
    - courseList: JList<Course>
    - courseListModel: DefaultListModel<Course>
    - courseNameField: JTextField
    - courseCodeField: JTextField
    - instructorField: JTextField
    - creditsField: JTextField
    - addCourseButton: JButton
    - updateCourseButton: JButton
    - removeCourseButton: JButton
    - taskPanel: JPanel
    - taskList: JList<Task>
    - taskListModel: DefaultListModel<Task>
    - taskTitleField: JTextField
    - taskDescriptionArea: JTextArea
    - taskDueDateField: JTextField
    - taskPriorityCombo: JComboBox<Task.Priority>
    - taskCourseCombo: JComboBox<String>
    - addTaskButton: JButton
    - updateTaskButton: JButton
    - removeTaskButton: JButton
    - completeTaskButton: JButton
    ..
    - initializeUI(): void
    - createStudentPanel(): void
    - createCoursePanel(): void
    - createTaskPanel(): void
    + modelChanged(): void
    ...
  }

  class PlannerController extends AbstractController {
    - service: PlannerService
    ..
    + saveStudentProfile(): void
    + addCourse(): void
    + updateCourse(): void
    + removeCourse(): void
    + addTask(): void
    ...
  }

}

package "planner.persistence" {

  class PlannerRepository {
    + savePlannerData(): void
    + loadPlannerData(): void
    - createDataDirectory(): void
    - saveStudent(): void
    - loadStudent(): Student
    ...
  }

}

package "planner.model" {

  class PlannerModel extends AbstractModel {
    - currentStudent: Student
    - courses: List<Course>
    - tasks: List<Task>
    ..
    + getCurrentStudent(): Student
    + setCurrentStudent(): void
    + getCourses(): List<Course>
    + getCourseById(): Optional<Course>
    + getCourseByCode(): Optional<Course>
    ...
  }

  class Course {
    - id: String
    - name: String
    - code: String
    - instructor: String
    - credits: int
    ..
    + getId(): String
    + getName(): String
    + getCode(): String
    + getInstructor(): String
    + getCredits(): int
    ...
  }

  class Priority {
    - id: String
    - title: String
    - description: String
    - dueDate: LocalDateTime
    - priority: Priority
    - completed: boolean
    - courseId: String
    ..
    + getId(): String
    + getTitle(): String
    + getDescription(): String
    + getDueDate(): LocalDateTime
    + getPriority(): Priority
    ...
  }

  class Student {
    - id: String
    - firstName: String
    - lastName: String
    - email: String
    - studentId: String
    - year: int
    - major: String
    ..
    + getId(): String
    + getFirstName(): String
    + getLastName(): String
    + getEmail(): String
    + getStudentId(): String
    ...
  }

}

package "planner.service" {

  class PlannerService {
    - model: PlannerModel
    ..
    + createStudentProfile(): void
    + updateStudentProfile(): void
    + addCourse(): Course
    + updateCourse(): void
    + removeCourse(): void
    ...
  }

}


' Relationships
Model <|.. AbstractModel
Controller <|.. AbstractController
View <|.. AbstractView
ModelListener <|.. AbstractView
AbstractView <|-- PlannerView
AbstractController <|-- PlannerController
AbstractModel <|-- PlannerModel

' MVC Pattern Relationships
Model ..> ModelEvent : uses
AbstractModel ..> ModelListener : notifies
AbstractView ..> ModelListener : implements
PlannerService --> PlannerModel : uses
PlannerController --> PlannerService : delegates

' Domain Relationships
PlannerModel "1" *-- "1" Student : manages
PlannerModel "1" *-- "0..*" Course : manages
PlannerModel "1" *-- "0..*" Task : manages
Task --> Course : associated with

@enduml
